#include <SoftwareSerial.h> //incluindo o bluetooth
#include <dht.h>  // biblioteca DHTlib 

// DEFINIÇÃO DE PINO DO SENSOR
#define pinSensor 7

// Intervalo de leitura (em milissegundos)
#define intervalo 2000

// CRIA VARIÁVEIS
unsigned long delayIntervalo = 0;
dht sensorDHT;

void setup() 
{
  Serial.begin(9600);

  Serial.println("Leitura do sensor DHT22 com DHTlib");
  Serial.println("Status\t\tTempo(us)\tUmidade(%)\tTemperatura(C)");
}

void loop() 
{
  if ((millis() - delayIntervalo) > intervalo) {

    unsigned long start = micros();
    int chk = sensorDHT.read22(pinSensor);
    unsigned long stop = micros();

    switch (chk)
    {
     //inserindo informações caso de erro
      case DHTLIB_OK:
           Serial.print("OK\t\t");
           break;
      case DHTLIB_ERROR_CHECKSUM:
           Serial.print("Erro de Checksum\t");
           break;
      case DHTLIB_ERROR_TIMEOUT:
           Serial.print("Erro de Timeout\t\t");
           break;
      case DHTLIB_ERROR_CONNECT:
           Serial.print("Erro de Conexão\t\t");
           break;
      case DHTLIB_ERROR_ACK_L:
           Serial.print("Erro ACK_L\t\t");
           break;
      case DHTLIB_ERROR_ACK_H:
           Serial.print("Erro ACK_H\t\t");
           break;
      default:
           Serial.print("Erro desconhecido\t");
           break;
    }
    //exibir as informações que o sensor recebe.

    Serial.print(stop - start);
    Serial.print("\t\t");
    Serial.print(sensorDHT.humidity, 1);
    Serial.print("\t\t");
    Serial.println(sensorDHT.temperature, 1);

    delayIntervalo = millis();
  }
}
